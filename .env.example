# SPARK AI ASSISTANT — ENVIRONMENT CONFIGURATION
# ===================================================================

# Primary agent brain provider: 'gemini' (default), 'claude', or 'openai_compatible'
SPARK_AI_PROVIDER=hybrid

# Google Gemini API key (server-side only, never committed or exposed to frontend)
GEMINI_API_KEY=

# Google Gemini Model identifier (default: current recommended Flash model for agent use)
GEMINI_MODEL=gemini-2.5-flash

# Local Ollama / Qwen Configuration
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b

# Allow effectful tools (PowerShell modifying commands, file writes).
# 0 = read-only (default, safe)
# 1 = full write/shell access
JARVIS_ALLOW_WRITES=0

# Bridge WebSocket port (default: 8787)
JARVIS_BRIDGE_PORT=8787
